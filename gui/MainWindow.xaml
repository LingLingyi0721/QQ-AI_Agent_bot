<Window x:Class="QQAgent.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QQ-AI_Agent 控制台"
        Width="1000"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="LogTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource LogBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧导航 ===== -->
        <Border Grid.Column="0"
                Background="{StaticResource NavBackground}"
                BorderBrush="{StaticResource CardStroke}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Height="48" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="QQ-AI_Agent" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="聊天型 LLM" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <RadioButton x:Name="NavModel" Content="模型配置" GroupName="Nav"
                                 Style="{StaticResource NavItem}" IsChecked="True" Tag="model" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavRuntime" Content="运行控制" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Tag="runtime" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavLogs" Content="日志" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Tag="logs" Checked="Nav_Checked" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="v0.1 · WPF" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="18,0,18,16" />
            </Grid>
        </Border>

        <!-- ===== 右侧内容 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="控制台" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" />
                    <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="Maximize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" x:Name="ContentScroll" Padding="24,8,24,24"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid>

                    <!-- ===== 页面 1：模型配置 ===== -->
                    <StackPanel x:Name="PageModel">
                        <TextBlock Text="模型配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="改完点「保存配置」写入 .env，Bot 重启后生效"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="服务商" Style="{StaticResource SectionTitle}" />
                                <ComboBox x:Name="ProviderBox" Width="280" HorizontalAlignment="Left"
                                          SelectionChanged="ProviderBox_SelectionChanged" />
                                <TextBlock x:Name="ProviderHint" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                           Text="切换服务商会覆盖 Base URL 与模型名；选「自定义」则清空两项" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="连接" Style="{StaticResource SectionTitle}" />

                                <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="BaseUrlBox" />

                                <TextBlock Text="模型名" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                <TextBox x:Name="ModelBox" TextChanged="ModelBox_TextChanged" />

                                <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyBox" />
                                    <TextBox x:Name="ApiKeyPlainBox" Visibility="Collapsed" />
                                    <ToggleButton Grid.Column="1" x:Name="ShowKeyToggle" Content="显示"
                                                  Style="{StaticResource GhostToggle}" Margin="8,0,0,0"
                                                  Checked="ShowKeyToggle_Changed" Unchecked="ShowKeyToggle_Changed" />
                                </Grid>

                                <TextBlock Text="人设文件（随模型名自动推断，不可编辑）"
                                           Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                <TextBox x:Name="PersonaBox" IsReadOnly="True" IsTabStop="False" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="思考等级" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="EffortOff" Content="关闭" GroupName="Effort"
                                                 Style="{StaticResource SegmentRadio}" IsChecked="True" />
                                    <RadioButton x:Name="EffortLow" Content="低" GroupName="Effort"
                                                 Style="{StaticResource SegmentRadio}" />
                                    <RadioButton x:Name="EffortMedium" Content="中" GroupName="Effort"
                                                 Style="{StaticResource SegmentRadio}" />
                                    <RadioButton x:Name="EffortHigh" Content="高" GroupName="Effort"
                                                 Style="{StaticResource SegmentRadio}" />
                                </StackPanel>
                                <TextBlock Text="映射为 reasoning_effort；不支持该参数的服务商会自动降级重试"
                                           Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="保存配置" Style="{StaticResource AccentButton}" Click="SaveButton_Click" />
                            <Button Content="重新载入" Margin="8,0,0,0" Click="ReloadButton_Click" />
                            <TextBlock x:Name="SaveStatus" Style="{StaticResource CaptionText}" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== 页面 2：运行控制 ===== -->
                    <StackPanel x:Name="PageRuntime" Visibility="Collapsed">
                        <TextBlock Text="运行控制" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="启动前会校验 .env 里的 LLM_API_KEY"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Bot 进程" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                             Fill="{StaticResource TextSecondary}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StatusText" Text="未运行" VerticalAlignment="Center" />
                                    <TextBlock x:Name="PidText" Style="{StaticResource CaptionText}" Margin="12,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="StartButton" Content="启动 Bot"
                                            Style="{StaticResource AccentButton}" Click="StartBot_Click" />
                                    <Button x:Name="StopButton" Content="停止 Bot" Margin="8,0,0,0"
                                            IsEnabled="False" Click="StopBot_Click" />
                                </StackPanel>

                                <TextBlock x:Name="RuntimeHint" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="OneBot 连接" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="WS 地址" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="WsText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="端口" Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="PortText" Grid.Column="1" FontSize="13" />
                                </Grid>
                                <TextBlock Text="只读：要改请编辑 config/config.yaml 的 onebot.ws_url"
                                           Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- ===== 页面 3：日志 ===== -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="日志" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox x:Name="AutoScrollCheck" Content="自动滚动" IsChecked="True" VerticalAlignment="Center" />
                                <Button Content="清空" Margin="16,0,0,0" Height="28" Click="ClearLog_Click" />
                                <Button Content="另存为" Margin="8,0,0,0" Height="28" Click="SaveLog_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Bot 的 stdout / stderr 实时输出"
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,8" />

                        <Border Grid.Row="2" Height="420" Style="{StaticResource CardBorder}"
                                Padding="0" Background="{StaticResource LogBackground}">
                            <TextBox x:Name="LogBox" Style="{StaticResource LogTextBoxStyle}" />
                        </Border>
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>