<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QQAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：整条是拖拽区，右端给系统最小化/最大化/关闭按钮留白 -->
        <Grid x:Name="TitleBarGrid" Height="44" Padding="16,0,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="QQ-AI_Agent" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            <Border x:Name="TitleBarRightSpacer" Grid.Column="2" Width="140" />
        </Grid>

        <!-- 任务管理器式侧栏：收起只显示图标栏，只由汉堡按钮开合；点导航项不收起、不悬停展开 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            OpenPaneLength="210"
            CompactPaneLength="48"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            Background="Transparent">

            <!-- 侧栏（pane）背景透明：WinUI 3 1.8 实际可用的键只有 Default / Expanded / TopPane，
                 MinimalPaneBackground 在本版本 .pri 中不存在，故不覆盖。 -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.RenderTransform>
                <CompositeTransform x:Name="PaneTransform" />
            </NavigationView.RenderTransform>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ModelNavItem" Content="模型配置" Tag="model">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RuntimeNavItem" Content="运行控制" Tag="runtime">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LogsNavItem" Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
