<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QQAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <!-- 导航按钮：无默认按钮底色，底色只由悬停/选中态提供 -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <!-- 侧栏宽度：收起 48 / 展开 200，由 MainWindow.AnimateSideBar 逐帧驱动本列宽度 -->
            <ColumnDefinition x:Name="SideBarColumn" Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 自绘侧栏：不再使用 NavigationView 的 pane 机制，X 基准恒为 0 -->
        <ContentControl x:Name="SideBar"
                Grid.Column="0"
                Padding="0"
                Background="Transparent"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AutomationProperties.AutomationId="SideBar"
                AutomationProperties.Name="侧栏">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ContentControl 默认模板不画边框，右侧分隔线自绘 1px -->
                <Border Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Button x:Name="HamburgerButton"
                        Grid.Row="0"
                        Width="48"
                        Height="48"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Click="Hamburger_Click"
                        AutomationProperties.AutomationId="HamburgerButton"
                        AutomationProperties.Name="展开或收起侧栏">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>

                <StackPanel x:Name="NavItems" Grid.Row="1" Spacing="2" Margin="0,4,0,0">
                    <Button x:Name="ModelNav" Tag="model" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavModel"
                            AutomationProperties.Name="模型配置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8D4;" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ModelText" Grid.Column="1" Text="模型配置"
                                       FontSize="14" VerticalAlignment="Center"
                                       Opacity="0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <Border Tag="indicator" Width="3" Height="18" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="RuntimeLogNav" Tag="runtimelog" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavRuntimeLog"
                            AutomationProperties.Name="运行与日志">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="RuntimeLogText" Grid.Column="1" Text="运行与日志"
                                       FontSize="14" VerticalAlignment="Center"
                                       Opacity="0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <Border Tag="indicator" Width="3" Height="18" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="ErrorsNav" Tag="errors" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavErrors"
                            AutomationProperties.Name="日志文件">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ErrorsText" Grid.Column="1" Text="日志文件"
                                       FontSize="14" VerticalAlignment="Center"
                                       Opacity="0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <Border Tag="indicator" Width="3" Height="18" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="2" Margin="0,0,0,8">
                    <Button x:Name="SettingsNav" Tag="settings" Style="{StaticResource NavButtonStyle}"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavSettings"
                            AutomationProperties.Name="设置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SettingsText" Grid.Column="1" Text="设置"
                                       FontSize="14" VerticalAlignment="Center"
                                       Opacity="0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <Border Tag="indicator" Width="3" Height="18" CornerRadius="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </ContentControl>

        <!-- 标题栏 + 内容 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏：整条是拖拽区，右端给系统最小化/最大化/关闭按钮留白 -->
            <Grid x:Name="TitleBarGrid" Height="44" Padding="16,0,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="QQ-AI_Agent" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                <Border x:Name="TitleBarRightSpacer" Grid.Column="2" Width="140" />
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" Background="Transparent" AutomationProperties.AutomationId="ContentFrame" />
        </Grid>
    </Grid>
</Window>
