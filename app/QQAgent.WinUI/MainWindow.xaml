<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QQAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：整条是拖拽区，右端给系统最小化/最大化/关闭按钮留白 -->
        <Grid x:Name="TitleBarGrid" Height="44" Padding="16,0,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="QQ-AI_Agent" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            <Border x:Name="TitleBarRightSpacer" Grid.Column="2" Width="140" />
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="210"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            Background="Transparent">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ModelNavItem" Content="模型配置" Tag="model">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RuntimeNavItem" Content="运行控制" Tag="runtime">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="LogsNavItem" Content="日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <TextBlock
                    Text="v0.1 · WinUI3"
                    FontSize="12"
                    Margin="16,8,16,12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
