<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.ErrorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="最近的报错"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,12"
                   AutomationProperties.AutomationId="PageTitle" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" VerticalAlignment="Center">
            <Button Content="刷新" Click="OnRefreshClicked" AutomationProperties.AutomationId="RefreshErrorsButton" />
            <Button Content="清空" Click="OnClearClicked" AutomationProperties.AutomationId="ClearErrorsButton" />
            <Button Content="复制全部" Click="OnCopyAllClicked" AutomationProperties.AutomationId="CopyErrorsButton" />
        </StackPanel>

        <InfoBar x:Name="NoticeBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />

        <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ScrollViewer x:Name="ErrorScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="12,10">
                    <StackPanel x:Name="ErrorList" Spacing="2" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Text="暂无报错"
                           FontSize="12"
                           Foreground="#9A9A9A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="EmptyErrorsText" />
            </Grid>
        </Border>
    </Grid>
</Page>