<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.ErrorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:QQAgent.WinUI.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="最近的报错"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,12"
                   AutomationProperties.AutomationId="PageTitle" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" VerticalAlignment="Center">
            <Button Content="刷新" Click="OnRefreshClicked" AutomationProperties.AutomationId="RefreshErrorsButton" />
            <Button Content="清空列表" Click="OnClearClicked" AutomationProperties.AutomationId="ClearErrorsButton" />
            <Button Content="打开日志文件" Click="OnOpenLogClicked" AutomationProperties.AutomationId="OpenErrorLogButton" />
            <Button Content="复制全部" Click="OnCopyAllClicked" AutomationProperties.AutomationId="CopyErrorsButton" />
        </StackPanel>

        <InfoBar x:Name="NoticeBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="0,0,0,8" />

        <!-- 条目式列表：每条报错一个独立卡片，最新的在最上面。 -->
        <Grid Grid.Row="3">
            <ListView x:Name="ErrorList"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Background="Transparent"
                      Padding="0,0,4,0"
                      AutomationProperties.AutomationId="ErrorList"
                      AutomationProperties.Name="报错列表">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ErrorItem">
                        <Border Margin="0,0,0,6"
                                Padding="12,10"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#F0D5D5"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind TimeText}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#8A8A8A"
                                           Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Message}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="#C42B1C" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText"
                       Text="暂无报错"
                       FontSize="12"
                       Foreground="#9A9A9A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="EmptyErrorsText" />
        </Grid>
    </Grid>
</Page>