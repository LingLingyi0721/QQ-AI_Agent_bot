<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.ErrorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:QQAgent.WinUI.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="日志文件"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,12"
                   AutomationProperties.AutomationId="PageTitle" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" VerticalAlignment="Center">
            <Button x:Name="RefreshButton" Content="刷新" Click="OnRefreshClicked" AutomationProperties.AutomationId="RefreshLogsButton" />
            <Button x:Name="OpenDirectoryButton" Content="打开目录" Click="OnOpenDirectoryClicked" AutomationProperties.AutomationId="OpenLogDirectoryButton" />
        </StackPanel>

        <!-- 文件列表：一行三列（文件名 / 大小 / 修改时间），点击条目在本程序内弹窗查看。 -->
        <Grid Grid.Row="2">
            <ListView x:Name="LogFileList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnItemClick"
                      Background="Transparent"
                      Padding="0,0,4,0"
                      AutomationProperties.AutomationId="LogFileList"
                      AutomationProperties.Name="日志文件列表">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogFileItem">
                        <Border Margin="0,0,0,6"
                                Padding="14,10"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#E1E1E1"
                                BorderThickness="1"
                                AutomationProperties.Name="{x:Bind Name}"
                                PointerEntered="OnItemPointerEntered"
                                PointerExited="OnItemPointerExited">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Name}"
                                           FontSize="13"
                                           Foreground="#1F1F1F"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind SizeText}"
                                           FontSize="12"
                                           Foreground="#8A8A8A"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind ModifiedText}"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           Foreground="#8A8A8A"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText"
                       Text="暂无日志文件"
                       FontSize="12"
                       Foreground="#9A9A9A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="EmptyLogFilesText" />
        </Grid>
        <!-- 提示浮层：系统 OSD 式，只在需要特殊提示时出现，自动淡出，不接收点击。 -->
        <Border x:Name="Osd"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,36"
                Background="#CC202020"
                CornerRadius="20"
                Padding="16,10"
                IsHitTestVisible="False"
                AutomationProperties.AutomationId="Osd">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="OsdIcon" FontSize="14" Foreground="#FFFFFF" />
                <TextBlock x:Name="OsdText"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           AutomationProperties.AutomationId="OsdText" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
