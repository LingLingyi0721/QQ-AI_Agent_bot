<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20,28,28">
            <StackPanel MaxWidth="960" Spacing="12" HorizontalAlignment="Stretch">

                <TextBlock Text="运行控制" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,4" />

                <!-- 卡片：Bot 进程 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Bot 进程" Style="{StaticResource SectionTitleStyle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Ellipse x:Name="StateDot" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateText" Text="未运行" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartButton" Content="启动 Bot" Style="{StaticResource AccentButtonStyle}" Click="OnStartClicked" />
                                <Button x:Name="StopButton" Content="停止 Bot" IsEnabled="False" Click="OnStopClicked" />
                            </StackPanel>
                        </Grid>

                        <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>