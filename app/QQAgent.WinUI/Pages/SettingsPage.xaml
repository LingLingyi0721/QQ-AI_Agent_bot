<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20,28,28">
            <StackPanel MaxWidth="960" Spacing="12" HorizontalAlignment="Stretch">

                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />

                <!-- 卡片：外观 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Spacing="8">
                            <TextBlock Text="主题" Style="{StaticResource SecondaryTextStyle}" />
                            <RadioButtons
                                x:Name="ThemeChoice"
                                MaxColumns="3"
                                SelectionChanged="OnThemeChoiceChanged">
                                <RadioButton Content="跟随系统" />
                                <RadioButton Content="浅色" />
                                <RadioButton Content="深色" />
                            </RadioButtons>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="主题色" Style="{StaticResource SecondaryTextStyle}" />
                            <RadioButtons
                                x:Name="AccentChoice"
                                MaxColumns="2"
                                SelectionChanged="OnAccentChoiceChanged">
                                <RadioButton Content="跟随系统" />
                                <RadioButton Content="自定义" />
                            </RadioButtons>

                            <StackPanel x:Name="AccentPanel" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Rectangle
                                    x:Name="AccentRect"
                                    Width="40"
                                    Height="28"
                                    RadiusX="6"
                                    RadiusY="6"
                                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                    StrokeThickness="1"
                                    Tapped="OnAccentSwatchTapped" />
                                <TextBlock
                                    x:Name="AccentText"
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    FontFamily="Consolas" />
                                <Button
                                    x:Name="PickColorButton"
                                    Content="选择颜色"
                                    VerticalAlignment="Center"
                                    Click="OnPickColorClicked">
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="ColorFlyout"
                                            Placement="Bottom"
                                            Closed="OnColorFlyoutClosed">
                                            <ColorPicker
                                                x:Name="AccentPicker"
                                                IsColorChannelTextInputVisible="True"
                                                IsAlphaEnabled="False"
                                                ColorSpectrumShape="Box"
                                                ColorChanged="OnAccentColorChanged" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片：关于 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="VersionText" Text="版本 v0.1.0" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="界面 WinUI 3" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="运行时 .NET 10 / Windows App SDK 1.8" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>