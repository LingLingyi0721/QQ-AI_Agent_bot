<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.ModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQAgent.WinUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20,28,28">
            <StackPanel MaxWidth="960" Spacing="12" HorizontalAlignment="Stretch">

                <StackPanel Spacing="4" Margin="0,0,0,4">
                    <TextBlock Text="模型配置" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="改完点保存，重启后生效" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <!-- 卡片 1：服务商 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="服务商" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox
                            x:Name="ProviderCombo"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnProviderSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Preset">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 卡片 2：连接 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="连接" Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Base URL" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox
                                x:Name="BaseUrlBox"
                                PlaceholderText="https://api.deepseek.com/v1"
                                TextChanged="OnBaseUrlChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="模型名" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox
                                x:Name="ModelBox"
                                PlaceholderText="deepseek-chat"
                                TextChanged="OnModelTextChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="API Key" Style="{StaticResource SecondaryTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <PasswordBox
                                        x:Name="ApiKeyBox"
                                        PasswordChanged="OnApiKeyPasswordChanged" />
                                    <TextBox
                                        x:Name="ApiKeyPlainBox"
                                        Visibility="Collapsed"
                                        TextChanged="OnApiKeyPlainTextChanged" />
                                </Grid>
                                <ToggleButton
                                    x:Name="RevealKeyToggle"
                                    Grid.Column="1"
                                    Width="44"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Checked="OnRevealKeyChecked"
                                    Unchecked="OnRevealKeyUnchecked">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                </ToggleButton>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 3：人设 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="人设" Style="{StaticResource SectionTitleStyle}" />

                        <RadioButtons
                            x:Name="PersonaMode"
                            MaxColumns="2"
                            SelectionChanged="OnPersonaModeChanged">
                            <RadioButton Content="默认" />
                            <RadioButton Content="自定义" />
                        </RadioButtons>

                        <TextBox
                            x:Name="PersonaAutoBox"
                            IsReadOnly="True"
                            Foreground="{ThemeResource TextFillColorDisabledBrush}" />

                        <Grid x:Name="PersonaCustomPanel" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                x:Name="PersonaCombo"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnPersonaSelectionChanged" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="编辑" Click="OnEditPersonaClicked" />
                                <Button Content="导入" Click="OnImportPersonaClicked" />
                                <Button Content="新建" Click="OnNewPersonaClicked" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 卡片 4：思考等级 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="思考等级" Style="{StaticResource SectionTitleStyle}" />
                        <RadioButtons
                            x:Name="ReasonLevel"
                            MaxColumns="4"
                            SelectionChanged="OnReasonLevelChanged">
                            <RadioButton Content="关闭" />
                            <RadioButton Content="低" />
                            <RadioButton Content="中" />
                            <RadioButton Content="高" />
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- 底部操作区 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button
                        x:Name="SaveButton"
                        Content="保存配置"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClicked" />
                    <Button
                        x:Name="ReloadButton"
                        Content="重新载入"
                        Click="OnReloadClicked" />
                </StackPanel>

                <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

