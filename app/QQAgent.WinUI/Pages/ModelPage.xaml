<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QQAgent.WinUI.Pages.ModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QQAgent.WinUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28,20,28,28">
            <StackPanel MaxWidth="960" Spacing="12" HorizontalAlignment="Stretch">

                <StackPanel Spacing="4" Margin="0,0,0,4">
                    <TextBlock Text="模型配置" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="改完点「保存配置」写入 .env，Bot 重启后生效" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <!-- 卡片 1：服务商 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="服务商" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox
                            x:Name="ProviderCombo"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnProviderSelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Preset">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <InfoBar
                            x:Name="ProviderInfoBar"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Informational" />
                    </StackPanel>
                </Border>

                <!-- 卡片 2：连接 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="连接" Style="{StaticResource SectionTitleStyle}" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Base URL" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox x:Name="BaseUrlBox" PlaceholderText="https://api.deepseek.com/v1" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="模型名" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox
                                x:Name="ModelBox"
                                PlaceholderText="deepseek-chat"
                                TextChanged="OnModelTextChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="API Key" Style="{StaticResource SecondaryTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <PasswordBox
                                        x:Name="ApiKeyBox"
                                        PasswordChanged="OnApiKeyPasswordChanged" />
                                    <TextBox
                                        x:Name="ApiKeyPlainBox"
                                        Visibility="Collapsed"
                                        TextChanged="OnApiKeyPlainTextChanged" />
                                </Grid>
                                <ToggleButton
                                    x:Name="RevealKeyToggle"
                                    Grid.Column="1"
                                    Width="44"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Checked="OnRevealKeyChecked"
                                    Unchecked="OnRevealKeyUnchecked">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                </ToggleButton>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="人设文件（随模型名自动推断）" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBox x:Name="PersonaBox" IsReadOnly="True" />
                        </StackPanel>

                        <TextBlock x:Name="BotRootText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- 卡片 3：思考等级 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="思考等级" Style="{StaticResource SectionTitleStyle}" />
                        <RadioButtons
                            x:Name="ReasonLevel"
                            MaxColumns="4">
                            <RadioButton Content="关闭" />
                            <RadioButton Content="低" />
                            <RadioButton Content="中" />
                            <RadioButton Content="高" />
                        </RadioButtons>
                        <TextBlock
                            Text="映射为 reasoning_effort，不支持该参数的服务商会自动降级重试"
                            Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- 卡片 4：外观 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                        <RadioButtons
                            x:Name="ThemeChoice"
                            MaxColumns="3"
                            SelectionChanged="OnThemeChoiceChanged">
                            <RadioButton Content="跟随系统" />
                            <RadioButton Content="浅色" />
                            <RadioButton Content="深色" />
                        </RadioButtons>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Rectangle
                                x:Name="AccentRect"
                                Width="32"
                                Height="24"
                                RadiusX="4"
                                RadiusY="4"
                                Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                StrokeThickness="1" />
                            <TextBlock x:Name="AccentText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 底部操作区 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button
                        x:Name="SaveButton"
                        Content="保存配置"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClicked" />
                    <Button
                        x:Name="ReloadButton"
                        Content="重新载入"
                        Click="OnReloadClicked" />
                </StackPanel>

                <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

