<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="QQAgent.WinUI.Dialogs.PersonaEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="人设"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Width="420" Spacing="12">
        <StackPanel Spacing="6">
            <Grid>
                <TextBlock Text="文件名" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock
                    x:Name="NameCountText"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="0/20" />
            </Grid>
            <TextBox
                x:Name="NameBox"
                MaxLength="20"
                PlaceholderText="如：my_persona"
                TextChanged="OnNameChanged" />
        </StackPanel>

        <StackPanel Spacing="6">
            <Grid>
                <TextBlock Text="内容" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock
                    x:Name="ContentCountText"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="0/200" />
            </Grid>
            <TextBox
                x:Name="ContentBox"
                Height="180"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                TextChanged="OnContentChanged" />
        </StackPanel>
    </StackPanel>
</ContentDialog>